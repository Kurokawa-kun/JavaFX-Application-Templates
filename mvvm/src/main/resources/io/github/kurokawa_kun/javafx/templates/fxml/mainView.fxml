<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane fx:id="borderPaneRoot" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.kurokawa_kun.javafx.templates.controllers.MainController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
         <menus>
            <Menu mnemonicParsing="false" text="%menu.file">
               <items>
                  <MenuItem fx:id="menuItemOpen" mnemonicParsing="false" onAction="#menuItemOpenOnAction" text="%menu.file.open" />
                  <MenuItem fx:id="menuItemExit" mnemonicParsing="false" onAction="#menuItemExitOnAction" text="%menu.file.exit" />
               </items>
            </Menu>
            <Menu fx:id="MenuEdit" mnemonicParsing="false" text="%menu.edit">
               <items>
                  <MenuItem fx:id="menuItemMonochrome" mnemonicParsing="false" onAction="#menuItemMonochromeOnAction" text="Monochrome" />
                  <MenuItem fx:id="menuItemHtmlColor" mnemonicParsing="false" onAction="#menuItemHtmlColorOnAction" text="HTML Color" />
               </items>
            </Menu>
            <Menu fx:id="menuHelp" mnemonicParsing="false" text="%menu.help">
               <items>
                  <MenuItem fx:id="menuItemAbout" mnemonicParsing="false" onAction="#menuItemAboutOnAction" text="%menu.help.about" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
   </top>
   <bottom>
      <HBox BorderPane.alignment="CENTER">
         <children>
            <Label text="%statusbar.zoomratio" />
            <Slider fx:id="sliderZoomRatio" blockIncrement="1.0" disable="true" max="7.0" min="1.0" value="4.0" />
            <Label fx:id="labelZoomRatio" />
         </children>
      </HBox>
   </bottom>
   <center>
      <ScrollPane fx:id="scrollPaneCurrentImage" fitToHeight="true" fitToWidth="true" BorderPane.alignment="CENTER">
         <content>
            <StackPane prefHeight="150.0" prefWidth="200.0">
               <children>
                  <Group>
                     <children>
                        <ImageView fx:id="imageViewCurrentImage" pickOnBounds="true" preserveRatio="true" />
                     </children>
                  </Group>
               </children>
            </StackPane>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
