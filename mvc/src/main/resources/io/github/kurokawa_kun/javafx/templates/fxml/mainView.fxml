<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="borderPane" prefHeight="320.0" prefWidth="480.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.kurokawa_kun.javafx.templates.controllers.MainController">
   <top>
      <ToolBar minHeight="-Infinity" BorderPane.alignment="CENTER">
         <items>
            <Button fx:id="buttonExit" mnemonicParsing="false" onAction="#buttonExitOnAction">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@icons/exit.png" />
                     </image></ImageView>
               </graphic></Button>
            <Button fx:id="buttonOpenDir" mnemonicParsing="false" onAction="#buttonOpenDirOnAction">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@icons/opendir.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
            <Button fx:id="buttonOpenSF" mnemonicParsing="false" onAction="#buttonOpenSF2OnAction">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@icons/opensf2.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </items>
      </ToolBar>
   </top>
   <bottom>
      <HBox alignment="CENTER" minHeight="60.0" minWidth="-Infinity" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="buttonPrev" mnemonicParsing="false" onAction="#buttonPrevOnAction">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@icons/prev.png" />
                     </image></ImageView>
               </graphic></Button>
            <Button fx:id="buttonStop" mnemonicParsing="false" onAction="#buttonStopOnAction">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@icons/stop_off.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <ToggleButton fx:id="toggleButtonPlay" mnemonicParsing="false" onAction="#toggleButtonPlayOnAction">
               <graphic>
                  <ImageView fx:id="imageViewPlay" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@icons/play_off.png" />
                     </image>
                  </ImageView>
               </graphic></ToggleButton>
            <Button fx:id="buttonNext" mnemonicParsing="false" onAction="#buttonNextOnAction">
               <graphic>
                  <ImageView pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@icons/next.png" />
                     </image></ImageView>
               </graphic></Button>
         </children>
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
      </HBox>
   </bottom>
   <center>
      <VBox minHeight="0.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="labelFileName" />
            <Label fx:id="labelTitle" layoutX="10.0" layoutY="10.0" />
         </children>
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
